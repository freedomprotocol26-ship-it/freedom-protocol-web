# ===========================================
# FREEDOM PROTOCOL - ENVIRONMENT VARIABLES
# ===========================================
# Copy this file to .env and fill in your values

# Server Configuration
PORT=3000
NODE_ENV=development

# ===========================================
# WHATSAPP CLOUD API (from Meta Business)
# ===========================================
# Get these from: https://developers.facebook.com/apps/
# 1. Create a Meta Business account
# 2. Create a new app (type: Business)
# 3. Add WhatsApp product
# 4. Get your test phone number ID and access token

WHATSAPP_ACCESS_TOKEN=your_meta_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WEBHOOK_VERIFY_TOKEN=freedom_protocol_webhook_2024

# ===========================================
# ANTHROPIC API (Claude)
# ===========================================
# Get from: https://console.anthropic.com/

ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ===========================================
# PAYSTACK (Payment Processing)
# ===========================================
# Get from: https://dashboard.paystack.com/#/settings/developers
# Use TEST keys for development, LIVE keys for production

PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===========================================
# DATABASE (PostgreSQL)
# ===========================================
# Option 1: Supabase (recommended for quick start)
#   - Create free account at supabase.com
#   - Get connection string from Project Settings > Database
#
# Option 2: Railway PostgreSQL
# Option 3: Local PostgreSQL

DATABASE_URL=postgresql://username:password@host:5432/freedom_protocol

# ===========================================
# APP SETTINGS
# ===========================================
# Your onboarding form URL (we'll create this later)
ONBOARDING_URL=https://your-app.up.railway.app/onboarding.html

# Base URL of your deployed app (for payment callbacks)
BASE_URL=https://your-app.up.railway.app
